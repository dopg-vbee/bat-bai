{
  "name": "bat-bai",
  "version": "1.0.0",
  "private": true,
  "description": "Bắt Bài – game party nghe lời đoán tên bài hát, chơi realtime qua trình duyệt",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run emoji && node --env-file-if-exists=.env --watch src/server/index.ts --dev",
    "build": "npm run emoji && vite build",
    "emoji": "node scripts/build-emoji.ts",
    "start": "node --env-file-if-exists=.env src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env scripts/restore.ts",
    "loadtest": "node --env-file-if-exists=.env scripts/loadtest.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@iconify-json/fluent-emoji": "^1.2.7",
    "@iconify/utils": "^3.1.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "canvas-confetti": "^1.9.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
