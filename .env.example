# Copy thành .env rồi điền. File .env không được commit.

# Mật khẩu vào trang quản lý câu hỏi / tạo phòng
ADMIN_PASSWORD=doi-mat-khau-nay

# Địa chỉ điện thoại sẽ mở khi quét QR. Bỏ trống: tự dùng IP Wi-Fi của máy này.
# Đặt khi có tên miền riêng hoặc app tự đoán sai IP, ví dụ: http://192.168.1.147:3001
# PUBLIC_URL=

# Cổng chạy server (mặc định 3001)
# PORT=3001

# --- Lưu trữ ---
# Để trống phần S3 thì dữ liệu lưu vào thư mục DATA_DIR (mặc định ./data).
# DATA_DIR=data

# Điền phần này để lưu lên Cloudflare R2 (hoặc S3 / Backblaze B2 / MinIO).
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=bat-bai
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
